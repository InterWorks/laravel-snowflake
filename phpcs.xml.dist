<?xml version="1.0"?>
<ruleset name="laravel-snowflake">
    <description>PSR-12, plus complexity and debugging checks Pint does not make.</description>

    <rule ref="PSR12">
        <!-- Pint formats multi-line conditions the other way. -->
        <exclude name="PSR12.ControlStructures.ControlStructureSpacing.FirstExpressionLine" />
        <exclude name="PSR12.ControlStructures.ControlStructureSpacing.CloseParenthesisLine" />
    </rule>

    <!-- Pest files mix helpers with test calls and have long test names. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <rule ref="Generic.Metrics.CyclomaticComplexity">
        <properties>
            <property name="complexity" value="15" />
            <property name="absoluteComplexity" value="43" />
        </properties>
    </rule>

    <rule ref="Generic.Metrics.NestingLevel">
        <properties>
            <property name="nestingLevel" value="5" />
            <property name="absoluteNestingLevel" value="7" />
        </properties>
    </rule>

    <!-- The tests dump objects on purpose, to prove a token stays hidden. -->
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <exclude-pattern>*/tests/Unit/AuthenticatorTest.php</exclude-pattern>
        <exclude-pattern>*/tests/Unit/SnowflakeExecuteTest.php</exclude-pattern>
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="dd" value="null" />
                <element key="dump" value="null" />
                <element key="ray" value="null" />
                <element key="var_dump" value="null" />
                <element key="print_r" value="null" />
            </property>
        </properties>
    </rule>

    <arg name="extensions" value="php" />
    <arg name="colors" />
    <arg value="sp" />

    <file>config</file>
    <file>src</file>
    <file>tests</file>
</ruleset>
