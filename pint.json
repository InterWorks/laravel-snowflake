{
    "preset": "psr12",
    "rules": {
        "ordered_class_elements": {
            "order": [
                "use_trait",
                "constant_public",
                "constant_protected",
                "constant_private",
                "property_public",
                "property_protected",
                "property_private",
                "construct",
                "destruct",
                "magic",
                "phpunit",
                "method"
            ],
            "sort_algorithm": "alpha"
        }
    }
}
